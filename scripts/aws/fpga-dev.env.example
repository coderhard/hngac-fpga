# Copy this file to fpga-dev.env and adjust values before launching.
# All AMI defaults below are current us-east-1 values only.

AWS_REGION=us-east-1
AWS_FPGA_TARGET=f2-dev

# Authentication is handled by your local AWS CLI environment.
# Example:
#   aws configure sso --profile hngac-aws
#   aws sso login --profile hngac-aws
#   AWS_PROFILE=hngac-aws scripts/aws/launch_fpga_dev_instance.sh scripts/aws/fpga-dev.env

AWS_FPGA_INSTANCE_NAME=hngac-fpga-dev
AWS_FPGA_VOLUME_SIZE_GB=200
AWS_FPGA_SECURITY_GROUP_NAME=hngac-fpga-dev-sg
AWS_FPGA_ENABLE_DCV=false
AWS_FPGA_WAIT_FOR_OK=true

# Set this explicitly if autodetect via https://checkip.amazonaws.com is undesirable.
# Examples:
#   AWS_FPGA_SSH_CIDR=203.0.113.10/32
#   AWS_FPGA_SSH_CIDR=203.0.113.0/24
AWS_FPGA_SSH_CIDR=

# Reuse an existing EC2 key pair, or let the launcher create one into ~/.ssh.
AWS_FPGA_KEY_NAME=hngac-fpga-dev
AWS_FPGA_CREATE_KEY_PAIR=false
AWS_FPGA_KEY_PATH=

# Leave blank to use the default VPC and one default subnet in the selected region.
AWS_FPGA_VPC_ID=
AWS_FPGA_SUBNET_ID=

# Optional bootstrap hook for EC2 user-data.
# Leave blank by default. If set, the file is passed through to run-instances as:
#   --user-data file://<path>
AWS_FPGA_USER_DATA_FILE=

# Optional descriptive tags.
AWS_FPGA_TAG_PROJECT=hngac-fpga
AWS_FPGA_TAG_OWNER=

# Default F2 Developer AMI settings from AWS F2 documentation.
AWS_FPGA_F2_UBUNTU_AMI_ID=ami-06691812f80312a04
AWS_FPGA_F2_ROCKY_AMI_ID=ami-0648ba8008e805297
AWS_FPGA_F2_DEV_INSTANCE_TYPE=c7i.4xlarge
AWS_FPGA_F2_HW_INSTANCE_TYPE=f2.6xlarge

# Target-specific overrides. Leave blank unless you need to override the defaults
# picked from AWS_FPGA_TARGET.
AWS_FPGA_AMI_ID=
AWS_FPGA_INSTANCE_TYPE=

# F1 is retired and blocked by default in the launcher.
# Enable only if you explicitly decide to pursue the legacy path and your account
# still qualifies to launch F1 after the 2025-12-20 retirement cutoff.
AWS_FPGA_ENABLE_F1=false
AWS_FPGA_F1_AMI_ID=ami-092fc5deb8f3c0f7d
AWS_FPGA_F1_INSTANCE_TYPE=f1.2xlarge
